{
  "name": "mikoto-web",
  "version": "0.1.0",
  "description": "Mikoto Web: deferred public web research through Pi codemode.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.spec.ts",
    "validate": "npm run check && npm test"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "typebox": "^1.3.7"
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=26"
  }
