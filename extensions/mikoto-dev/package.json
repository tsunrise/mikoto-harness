{
  "name": "mikoto-dev",
  "version": "0.1.0",
  "description": "Mikoto Dev: developer debugging commands for Pi.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "debugging"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "validate": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
