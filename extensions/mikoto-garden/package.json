{
  "name": "mikoto-garden",
  "version": "0.1.0",
  "description": "Mikoto Garden: macOS sandboxed managed commands.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test test/*.spec.ts",
    "validate": "npm run build && npm run check && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^24.0.0",
    "mikoto-types": "^0.1.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "index.ts",
    "src",
    "scripts",
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=26"
  }
}
