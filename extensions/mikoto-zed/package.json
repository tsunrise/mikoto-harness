{
  "name": "mikoto-zed",
  "version": "0.2.0",
  "description": "Mikoto Zed: pass the active Zed editor file and selection to the Earendil Works Pi coding agent.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "zed"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "validate": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
