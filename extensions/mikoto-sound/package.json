{
  "name": "mikoto-sound",
  "version": "0.1.0",
  "description": "Mikoto Sound: macOS sound effects for Pi lifecycle and inter-extension events.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "sound",
    "macos"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "resources",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "validate": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.0.0",
    "mikoto-types": "^0.1.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
