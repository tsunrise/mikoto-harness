{
  "name": "mikoto-question",
  "version": "0.1.0",
  "description": "Mikoto Question: a Codex-compatible request_user_input tool for Pi with a terminal questionnaire and Do not disturb mode.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "request-user-input"
  ],
  "license": "MIT",
	"type": "module",
	"files": [
		"index.ts",
		"src",
		"README.md"
	],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "validate": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.0.0",
    "mikoto-types": "^0.1.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
