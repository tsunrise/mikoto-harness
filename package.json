{
  "name": "mikoto-harness",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace for Mikoto Pi extensions and shared libraries.",
  "license": "MIT",
  "workspaces": [
    "extensions/*",
    "shared/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate": "npm run validate --workspaces --if-present"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.1.0",
      "onFail": "download"
    }
  }
}
